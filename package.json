{
  "name": "plexia",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:studio": "pnpm --filter @plexia/studio dev --host 0.0.0.0 --port 3000 --strictPort",
    "dev:connect": "pnpm --filter @plexia/connect dev --host 0.0.0.0 --port 3001 --strictPort",
    "build": "pnpm --filter @plexia/studio build && pnpm --filter @plexia/connect build",
    "typecheck": "pnpm --filter @plexia/shared typecheck && pnpm --filter @plexia/studio typecheck && pnpm --filter @plexia/connect typecheck",
    "test": "pnpm --filter @plexia/shared test",
    "export:repos": "node scripts/export-repos.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
